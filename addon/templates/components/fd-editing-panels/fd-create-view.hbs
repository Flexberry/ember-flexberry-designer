<div class="ui equal width grid fd-view-table-attr">
  <div class="column">
    {{fd-ember-jstree
      data=tree
      selectedNodes=selectedNodes
      loadDataNode=loadDataNode
      searchTerm=searchTerm
      treeObject=treeObject
      multiple=true
    }}
  </div>
  <div class="fd-view-buttons">
    <div class="ui vertical buttons">
      <button class="ui button icon {{if (and (not readonly) selectedNodesArray) '' 'disabled'}}" {{action 'addNodeInDefinition'}} title="{{t 'components.fd-create-view.add-to-view'}}">
        <i class="arrow right icon"></i>
      </button>
      <button class="ui button icon {{if (and (not readonly) selectedProperties) '' 'disabled'}}" {{action 'changeOrderDefinition' true}} title="{{t 'components.fd-create-view.move-up'}}">
        <i class="arrow up icon"></i>
      </button>
      <button class="ui button icon {{if (and (not readonly) selectedProperties) '' 'disabled'}}" {{action 'changeOrderDefinition' false}} title="{{t 'components.fd-create-view.move-down'}}">
        <i class="arrow down icon"></i>
      </button>
    </div>
  </div>
  <div class="column">
    {{fd-search-input
      value=searchValue
      class="field"
    }}
    <div class="overflow-panel">
      <div class="ui grid fd-list view-definition">
        {{#each view.definitionArray as |definition|}}
          {{fd-view-definition-item
            definition=definition
            filterValue=searchValue
            selectedProperties=selectedProperties
            selectedPropertyType=selectedPropertyType
            delete=(action 'deleteDefinitionItem')
            masterProperties=masterProperties
            readonly=readonly
          }}
        {{/each}}
      </div>
    </div>
  </div>
</div>

{{#if (eq selectedProperties.length 1)}}
  <div class="ui stackable grid fd-list fd-attr-prop">

    <div class="row">
      <div class="five wide column">
        {{t "components.fd-create-view.settings-view.path"}}
      </div>
      <div class="eleven wide column light-text">
        {{flexberry-textbox
          value=selectedProperties.firstObject.path
          class='fluid input'
          placeholder=(t "components.fd-create-view.settings-view.path-placeholder")
          readonly=readonly
        }}
      </div>
    </div>

    {{#if (eq selectedPropertyType 'isMaster')}}
      <div class="row">
        <div class="five wide column">
          {{t "components.fd-create-view.settings-master.lookup-type"}}
        </div>
        <div class="eleven wide column light-text">
          {{flexberry-dropdown
            onChange=(action "changeLookupType")
            items=(array 'default' 'standard' 'combo')
            value=selectedProperties.firstObject.lookupType
            readonly=readonly
            settings=(hash direction="upward")
          }}
        </div>
      </div>

      {{#if (not-eq selectedProperties.firstObject.lookupType 'default')}}
        <div class="row">
          <div class="five wide column">
            {{t "components.fd-create-view.settings-master.master-property"}}
          </div>
          <div class="six wide column light-text">
            {{#if selectedProperties.firstObject.inputManually}}
              {{flexberry-textbox
                value=selectedProperties.firstObject.masterPropertyName
                class='fluid input'
                placeholder=(t "components.fd-create-view.settings-master.master-property-placeholder")
                readonly=readonly
              }}
            {{else}}
              {{#if reInitMasterPropertiesDropdown}}
                {{flexberry-dropdown
                  items=masterProperties
                  value=selectedProperties.firstObject.masterPropertyName
                  readonly=readonly
                }}
              {{/if}}
            {{/if}}
          </div>
          <div class="five wide column light-text">
            {{flexberry-checkbox
              value=selectedProperties.firstObject.inputManually
              readonly=readonly
              label=(t "components.fd-create-view.input-manually")
              onChange=(action 'inputManuallyChanged')
            }}
          </div>
        </div>

        <div class="row">
          <div class="five wide column">
            {{t "components.fd-create-view.settings-master.sample-setting"}}
          </div>
          <div class="eleven wide column light-text">
            {{flexberry-textbox
              value=selectedProperties.firstObject.masterCustomizationString
              class='fluid input'
              placeholder=(t "components.fd-create-view.settings-master.sample-setting-placeholder")
              readonly=readonly
            }}
          </div>
        </div>
      {{/if}}
    {{/if}}

    {{#if (eq selectedPropertyType 'isDetail')}}
      <div class="row">
        <div class="five wide column">
          {{t "components.fd-create-view.settings-detail.view"}}
        </div>
        <div class="eleven wide column light-text">
          {{flexberry-dropdown
            items=detailView
            needChecksOnValue=false
            value=selectedProperties.firstObject.detailViewName
            readonly=readonly
          }}
        </div>
      </div>

      <div class="row">
        <div class="five wide column">
          {{t "components.fd-create-view.settings-detail.load-on-load-agregator"}}
        </div>
        <div class="eleven wide column light-text">
          {{flexberry-checkbox
            value=selectedProperties.firstObject.loadOnLoadAgregator
            readonly=readonly
          }}
        </div>
      </div>
    {{/if}}
  </div>
{{/if}}
