<div class="ui stackable grid">
  <div class="row">
    {{#each-in newGenerationItems as |title items|}}
      {{#if items.caption}}
        <h2 class="form-header">{{items.caption}}</h2>
      {{/if}}
      <div class="sixteen wide eight wide large screen eight wide widescreen column">
        <div class="fd-card horizontal expanded {{items.className}}">
          <div class="image text-align-center">
            <h4 class="header">{{title}}</h4>
            {{fd-generation-settings/products-logo className=items.className}}
          </div>
          <div class="content">
            {{#each-in items as |label value|}}
              {{#if (and (not-eq label "className") (not-eq label "caption"))}}
                {{#if (includes textFields label)}}
                  {{flexberry-field
                    value=value
                    readonly=(includes readonlyFields label)
                    label=(t (concat "components.fd-generation-settings." label))
                    change=(action 'selectGenSetting' label items)
                  }}
                {{else}}
                  <div class="field">
                    {{flexberry-checkbox
                      value=value
                      readonly=(includes readonlyFields label)
                      label=label
                      onChange=(action 'selectGenSetting' label items bubbles=false)
                    }}
                  </div>
                {{/if}}
              {{/if}}
            {{/each-in}}
          </div>
        </div>
      </div>
    {{/each-in}}
  </div>
</div>
